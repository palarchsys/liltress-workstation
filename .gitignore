# Jeton Ubuntu Pro et mot de passe d'application Gmail.
# Écrit par configure.sh, en mode 600.
secrets.conf
*.conf.save
*.save.conf
*.env

# Empreinte des comptes. Le fichier réel est sur la machine, en mode 600.
human.tsv

# Rapports de lynis.sh, et copie de l'installation
# lorsque DEBUG_INSTALL_LOG=1 dans global.conf.
log/

# Journaux, alertes et quarantaine. Les scripts restent dans service/cron/.
/cron/

# Rapports du banc statique.
test/output/

# Recette de verify/workstation.sh lorsqu'elle est lancée
# depuis le dossier des sources, sans journal d'installation.
verify-report-*.md

# Anciennes recettes texte, si un dossier en contient encore.
verify-report-*.txt
verify-report-*.tsv

