[Unit]
Description=Ouvre le tunnel choisi au demarrage
After=network-online.target w-vpn-killswitch.service
Requires=w-vpn-killswitch.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStart=/usr/bin/bash @ROOT@/service/vpn/cli.sh boot-up

[Install]
WantedBy=multi-user.target
