[Unit]
Description=Arme le killswitch du tunnel
After=network-online.target ufw.service
Before=w-vpn.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash @ROOT@/service/vpn/cli.sh boot-killswitch

[Install]
WantedBy=multi-user.target
