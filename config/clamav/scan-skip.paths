# -----------------------------------------------------------------------------
# Purpose    : Paths excluded from the blocking scan and the boot pass.
# Note       : # home=__HOME__
# Note       : A path under that home, or under /var/jeux.
# Note       : sudo bash __HFU_BASE__/script/scan-skip.sh list
# Note       : sudo bash __HFU_BASE__/script/scan-skip.sh add /chemin
# Note       : sudo bash __HFU_BASE__/script/scan-skip.sh del /chemin
# -----------------------------------------------------------------------------

__HOME__/.cache
__HOME__/snap
/var/jeux
