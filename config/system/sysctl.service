[Unit]
Description=Liltress Workstation sysctl
Documentation=file://__HF_BASE__
After=systemd-sysctl.service network-online.target
Wants=systemd-sysctl.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=__HF_BASE__/system/sysctl/w-sysctl-apply.sh

[Install]
WantedBy=multi-user.target
