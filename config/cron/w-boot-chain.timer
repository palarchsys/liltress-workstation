[Unit]
Description=Lance la chaîne de sécurité à chaque démarrage

[Timer]
OnBootSec=${BOOT_ON_BOOT_SEC}
AccuracySec=${BOOT_ACCURACY}
Persistent=${TIMER_PERSISTENT}
Unit=w-boot-chain.service

[Install]
WantedBy=timers.target
