[Unit]
Description=Relance AIDE, rkhunter, chkrootkit et debsums toutes les heures

[Timer]
OnBootSec=${HOURLY_ON_BOOT_SEC}
OnUnitActiveSec=${HOURLY_EVERY}
AccuracySec=${HOURLY_ACCURACY}
Persistent=${TIMER_PERSISTENT}
Unit=w-hourly-scan.service

[Install]
WantedBy=timers.target
