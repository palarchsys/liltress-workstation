[Unit]
Description=Relance l'analyse différée des bibliothèques

[Timer]
OnUnitActiveSec=${IDLE_EVERY}
AccuracySec=${IDLE_ACCURACY}
Persistent=${TIMER_PERSISTENT}
Unit=w-idle-scan.service

[Install]
WantedBy=timers.target
