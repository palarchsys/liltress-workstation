[Unit]
Description=Vérifie si un redémarrage est utile

[Timer]
OnUnitActiveSec=${REBOOT_EVERY}
AccuracySec=${REBOOT_ACCURACY}
Persistent=${TIMER_PERSISTENT}
Unit=w-reboot-notice.service

[Install]
WantedBy=timers.target
