[Unit]
Description=Chaîne de scan périodique
After=local-fs.target multi-user.target

[Service]
Type=oneshot
Nice=${WATCHDOG_LIMIT_NICE}
IOSchedulingClass=idle
CPUQuota=${cpu_quota}%
ExecStart=${CONFIG_BASE_DIRECTORY}/service/cron/watchdogs/chain-periodic.sh
