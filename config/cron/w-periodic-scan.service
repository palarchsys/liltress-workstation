[Unit]
Description=Analyse ClamAV toutes les deux heures
After=local-fs.target multi-user.target

[Service]
Type=oneshot
Nice=${WATCHDOG_LIMIT_NICE}
IOSchedulingClass=idle
CPUQuota=${cpu_quota}%
Environment=W_CLAMAV_DEFER=1
ExecStart=${CONFIG_BASE_DIRECTORY}/cron/bin/clamav.sh
