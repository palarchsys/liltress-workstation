[Unit]
Description=Passe de sécurité après le démarrage
After=local-fs.target multi-user.target
DefaultDependencies=no

[Service]
Type=oneshot
Nice=${WATCHDOG_LIMIT_NICE}
IOSchedulingClass=idle
CPUQuota=${cpu_quota}%
ExecStart=${CONFIG_BASE_DIRECTORY}/service/cron/watchdogs/boot-scan.sh
