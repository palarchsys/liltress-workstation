[Unit]
Description=Lance la passe de démarrage
After=multi-user.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=-${systemctl_bin} start --wait w-boot-scan.service
ExecStart=/bin/sh -c '${systemctl_bin} is-failed --quiet w-boot-scan.service && exit 1 || exit 0'
