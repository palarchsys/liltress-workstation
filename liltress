set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${ROOT}/core/run/launch.sh" ]]; then
    # shellcheck disable=SC1091
    source "${ROOT}/core/run/launch.sh"
elif [[ -f "${ROOT}/../share/core/run/launch.sh" ]]; then
    # shellcheck disable=SC1091
    source "${ROOT}/../share/core/run/launch.sh"
else
    printf 'launch.sh introuvable depuis %s\n' "${ROOT}" >&2
    exit 1
fi
run_launch "${ROOT}" "$@"
